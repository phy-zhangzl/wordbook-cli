# Provider settings
# For local Ollama term lookup:
PROVIDER=ollama
MODEL=your-ollama-model
API_BASE=http://localhost:11434
API_KEY=

# OpenAI-compatible example:
# PROVIDER=openai
# MODEL=
# API_BASE=
# API_KEY=

# Optional overrides
# WORD_AGENT_CONFIG=~/.config/word_agent/config.json
# WORDBOOK_PATH=data/wordbook.csv
# DICT_PATH=ecdict.csv
# CACHE_DIR=data/cache
# ALLOW_REMOTE=1
